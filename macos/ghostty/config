# Fonts
font-family = Space Mono
font-family-italic = Operator Mono
font-style-italic = Book Italic
font-size = 16
window-inherit-font-size = false

adjust-cell-height = 8

# Window
background-opacity = 0.95
background-blur = 25
macos-titlebar-style = hidden
window-padding-x = 16
window-padding-y = 16
background-opacity-cells = false
confirm-close-surface = false

config-file = yugen.conf
# `theme` links a palette override here; absent means yugen.
config-file = ?~/.local/state/dotfiles/ghostty.conf
