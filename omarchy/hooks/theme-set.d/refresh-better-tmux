#!/bin/bash
# Re-apply better-tmux after `omarchy theme set` so the bar tracks colors.toml.
set -euo pipefail

if ! tmux list-sessions >/dev/null 2>&1; then
  exit 0
fi

cli="${HOME}/.local/bin/better-tmux"
file="${HOME}/.config/better-tmux/index.tsx"
if [[ -x $cli && -f $file ]]; then
  "$cli" --file "$file"
fi

# better-tmux clears status-right, which drops the continuum autosave hook.
continuum="${HOME}/.config/tmux/plugins/tmux-continuum/continuum.tmux"
if [[ -x $continuum ]]; then
  "$continuum" >/dev/null 2>&1 || true
fi

# Keep panes + status transparent so Ghostty/Hyprland opacity shows through.
# better-tmux only writes legacy status-bg/fg; modern tmux renders status-style
# (defaults to solid green). omarchy-theme-set-tmux paints a solid window-style.
tmux set-option -g status-style bg=default,fg=default
tmux set-option -g window-style default
tmux set-option -g window-active-style default
