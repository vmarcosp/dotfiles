#!/usr/bin/env bash
set -euo pipefail

LOCAL="${HOME}/.agents/AGENTS.local.md"
RULE="${HOME}/.cursor/rules/machine-local.mdc"

if [[ ! -f "$LOCAL" ]]; then
  printf 'No %s — skipping Cursor rule sync\n' "$LOCAL" >&2
  exit 0
fi

mkdir -p "$(dirname "$RULE")"
{
  printf '%s\n' '---' 'alwaysApply: true' '---' ''
  cat "$LOCAL"
} > "$RULE"

printf 'Synced %s -> %s\n' "$LOCAL" "$RULE"
