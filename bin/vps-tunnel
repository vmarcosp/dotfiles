#!/usr/bin/env bash
#
# vps-tunnel - SSH SOCKS proxy to reach VPS localhost from your Mac (Mac only)
# Usage: vps-tunnel [start|stop|status|open] [url]
#

set -euo pipefail

HOST="${VPS_TUNNEL_HOST:-vps}"
SOCKS_PORT="${VPS_TUNNEL_PORT:-1080}"
PID_FILE="${VPS_TUNNEL_PID_FILE:-${XDG_RUNTIME_DIR:-/tmp}/vps-tunnel-${SOCKS_PORT}.pid}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
RESET='\033[0m'

die() {
  printf '%b✗ %s%b\n' "$RED" "$*" "$RESET" >&2
  exit 1
}

info() {
  printf '%b→ %s%b\n' "$CYAN" "$*" "$RESET"
}

success() {
  printf '%b✓ %s%b\n' "$GREEN" "$*" "$RESET"
}

require_macos() {
  [[ "$(uname -s)" == "Darwin" ]] || die "vps-tunnel runs on macOS only (SSH client side)."
}

require_ssh() {
  command -v ssh >/dev/null || die "ssh not found."
}

tunnel_running() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

proxy_instructions() {
  cat <<EOF

${DIM}Browser proxy (Firefox):${RESET}
  Settings → Network → Settings → Manual proxy
  SOCKS Host: 127.0.0.1  Port: ${SOCKS_PORT}  SOCKS v5
  ✓ Proxy DNS when using SOCKS v5

${DIM}Safari (system proxy):${RESET}
  System Settings → Network → Wi‑Fi → Details → Proxies → SOCKS Proxy
  127.0.0.1:${SOCKS_PORT}

${DIM}Then open VPS localhost in the browser, e.g.:${RESET}
  http://localhost:8765

${DIM}Terminal:${RESET}
  curl --socks5-hostname 127.0.0.1:${SOCKS_PORT} http://localhost:8765/api/hello

EOF
}

usage() {
  cat <<EOF
vps-tunnel — SOCKS proxy to VPS localhost (Mac ↔ ${HOST})

Usage:
  vps-tunnel              start tunnel (foreground)
  vps-tunnel start        start tunnel in background
  vps-tunnel stop         stop background tunnel
  vps-tunnel status       show tunnel state
  vps-tunnel open [url]   start (if needed) and open url in browser

Environment:
  VPS_TUNNEL_HOST   SSH host (default: vps)
  VPS_TUNNEL_PORT   local SOCKS port (default: 1080)

EOF
}

start_foreground() {
  tunnel_running && die "Tunnel already running (PID $(cat "$PID_FILE")). Use: vps-tunnel stop"

  info "SOCKS proxy on 127.0.0.1:${SOCKS_PORT} → ${HOST} (Ctrl+C to stop)"
  proxy_instructions
  exec ssh -N -D "127.0.0.1:${SOCKS_PORT}" "$HOST"
}

start_background() {
  tunnel_running && die "Tunnel already running (PID $(cat "$PID_FILE")). Use: vps-tunnel stop"

  info "Starting SOCKS tunnel to ${HOST} on 127.0.0.1:${SOCKS_PORT}…"
  ssh -N -f -D "127.0.0.1:${SOCKS_PORT}" "$HOST"

  local pid
  pid="$(lsof -ti "tcp:${SOCKS_PORT}" -sTCP:LISTEN 2>/dev/null | head -1)"
  [[ -n "$pid" ]] || die "Tunnel failed to start."
  printf '%s\n' "$pid" >"$PID_FILE"

  success "Tunnel running (PID ${pid})"
  proxy_instructions
}

stop_tunnel() {
  if tunnel_running; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
    success "Tunnel stopped."
    return 0
  fi

  rm -f "$PID_FILE"
  local pid
  pid="$(lsof -ti "tcp:${SOCKS_PORT}" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    success "Stopped listener on port ${SOCKS_PORT} (PID ${pid})."
  else
    info "No tunnel running on port ${SOCKS_PORT}."
  fi
}

show_status() {
  if tunnel_running; then
    success "Tunnel active — 127.0.0.1:${SOCKS_PORT} → ${HOST} (PID $(cat "$PID_FILE"))"
    return 0
  fi

  local pid
  pid="$(lsof -ti "tcp:${SOCKS_PORT}" -sTCP:LISTEN 2>/dev/null | head -1 || true)"
  if [[ -n "$pid" ]]; then
    success "Port ${SOCKS_PORT} in use (PID ${pid}) — not tracked by ${PID_FILE}"
    return 0
  fi

  info "No tunnel on 127.0.0.1:${SOCKS_PORT}."
  return 1
}

open_url() {
  local url="${1:-http://localhost:8765}"
  if ! tunnel_running && [[ -z "$(lsof -ti "tcp:${SOCKS_PORT}" -sTCP:LISTEN 2>/dev/null | head -1 || true)" ]]; then
    start_background
  fi
  info "Opening ${url} (browser must use SOCKS 127.0.0.1:${SOCKS_PORT})"
  open "$url"
}

main() {
  local cmd="${1:-start}"

  case "$cmd" in
    -h|--help|help)
      usage
      exit 0
      ;;
    start)
      require_macos
      require_ssh
      if [[ "${2:-}" == "--fg" || "${VPS_TUNNEL_FG:-}" == "1" ]]; then
        start_foreground
      else
        start_background
      fi
      ;;
    stop)
      require_macos
      stop_tunnel
      ;;
    status)
      require_macos
      show_status
      ;;
    open)
      require_macos
      open_url "${2:-http://localhost:8765}"
      ;;
    --fg)
      require_macos
      require_ssh
      start_foreground
      ;;
    *)
      die "Unknown command: $cmd (try --help)"
      ;;
  esac
}

# Bare `vps-tunnel` → foreground (easy to stop with Ctrl+C)
if [[ $# -eq 0 ]]; then
  require_macos
  require_ssh
  start_foreground
fi

main "$@"
