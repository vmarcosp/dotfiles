#!/usr/bin/env bash
#
# vps-tunnel - SSH port forward to VPS localhost (Mac ↔ VPS)
# Usage: vps-tunnel <port> | vps-tunnel stop <port> | vps-tunnel status
#

set -euo pipefail

HOST="${VPS_TUNNEL_HOST:-vps}"
TIMEOUT="${VPS_TUNNEL_TIMEOUT:-7200}" # seconds; 0 = no limit
PID_DIR="${VPS_TUNNEL_PID_DIR:-${XDG_RUNTIME_DIR:-/tmp}}"

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
DIM='\033[2m'
RESET='\033[0m'

die() {
  printf '%b✗ %s%b\n' "$RED" "$*" "$RESET" >&2
  exit 1
}

info() {
  printf '%b→ %s%b\n' "$CYAN" "$*" "$RESET"
}

success() {
  printf '%b✓ %s%b\n' "$GREEN" "$*" "$RESET"
}

pid_file() {
  printf '%s/vps-tunnel-%s.pid\n' "$PID_DIR" "$1"
}

require_ssh() {
  command -v ssh >/dev/null || die "ssh not found."
}

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( "$1" >= 1 && "$1" <= 65535 ))
}

read_pid() {
  local file
  file="$(pid_file "$1")"
  [[ -f "$file" ]] || return 1
  local pid
  pid="$(cat "$file" 2>/dev/null)" || return 1
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$pid"
}

forward_running() {
  local port="$1" pid
  pid="$(read_pid "$port" 2>/dev/null || true)"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

listener_pid() {
  lsof -ti "tcp:$1" -sTCP:LISTEN 2>/dev/null | head -1
}

usage() {
  cat <<EOF
vps-tunnel — forward localhost:<port> to VPS localhost:<port> via SSH

Usage:
  vps-tunnel <port>        start forward (Ctrl+C to stop, auto-stop after 2h)
  vps-tunnel stop <port>   stop forward on port
  vps-tunnel status        list active forwards

Examples:
  vps-tunnel 8765
  open http://localhost:8765

Environment:
  VPS_TUNNEL_HOST      SSH host (default: vps)
  VPS_TUNNEL_TIMEOUT   auto-stop seconds (default: 7200; 0 = no limit)

EOF
}

format_duration() {
  local s="$1"
  if (( s >= 3600 )); then
    printf '%dh %dm' $(( s / 3600 )) $(( (s % 3600) / 60 ))
  elif (( s >= 60 )); then
    printf '%dm' $(( s / 60 ))
  else
    printf '%ds' "$s"
  fi
}

start_forward() {
  local port="$1"
  valid_port "$port" || die "Invalid port: $port"

  if forward_running "$port"; then
    die "Port $port already forwarded (PID $(read_pid "$port")). Use: vps-tunnel stop $port"
  fi

  local existing
  existing="$(listener_pid "$port" || true)"
  if [[ -n "$existing" ]]; then
    die "Port $port already in use (PID $existing)."
  fi

  require_ssh

  local timeout_msg="no limit"
  if (( TIMEOUT > 0 )); then
    timeout_msg="$(format_duration "$TIMEOUT")"
  fi

  info "Forwarding localhost:${port} → ${HOST}:localhost:${port}"
  info "Open http://localhost:${port} in the browser (Ctrl+C to stop, timeout: ${timeout_msg})"

  file="$(pid_file "$port")"
  rm -f "$file"

  local ssh_args=(
    -o ExitOnForwardFailure=yes
    -L "127.0.0.1:${port}:127.0.0.1:${port}"
    -N
    "$HOST"
  )

  ssh "${ssh_args[@]}" &
  ssh_pid=$!
  printf '%s\n' "$ssh_pid" >"$file"

  timer_pid=""
  if (( TIMEOUT > 0 )); then
    (
      sleep "$TIMEOUT"
      if kill -0 "$ssh_pid" 2>/dev/null; then
        info "Timeout ($(format_duration "$TIMEOUT")) — stopping forward on port ${port}"
        kill "$ssh_pid" 2>/dev/null || true
      fi
    ) &
    timer_pid=$!
  fi

  cleanup() {
    kill "${ssh_pid:-}" "${timer_pid:-}" 2>/dev/null || true
    rm -f "${file:-}"
  }
  trap cleanup EXIT INT TERM

  wait "$ssh_pid" 2>/dev/null || true
  info "Forward on port ${port} ended."
}

stop_forward() {
  local port="$1"
  valid_port "$port" || die "Invalid port: $port"

  local file pid stopped=false
  file="$(pid_file "$port")"
  pid="$(read_pid "$port" 2>/dev/null || true)"

  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    stopped=true
  fi
  rm -f "$file"

  local listener
  listener="$(listener_pid "$port" || true)"
  if [[ -n "$listener" ]]; then
    kill "$listener" 2>/dev/null || true
    stopped=true
  fi

  if $stopped; then
    success "Stopped forward on port ${port}."
  else
    info "No forward running on port ${port}."
  fi
}

show_status() {
  local found=false

  for file in "$PID_DIR"/vps-tunnel-*.pid; do
    [[ -e "$file" ]] || continue
    local port="${file##*/vps-tunnel-}"
    port="${port%.pid}"
    local pid
    pid="$(cat "$file" 2>/dev/null || true)"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      success "Port ${port} → ${HOST} (PID ${pid}) — http://localhost:${port}"
      found=true
    else
      rm -f "$file"
    fi
  done

  if ! $found; then
    info "No active forwards."
    return 1
  fi
}

main() {
  case "${1:-}" in
    -h|--help|help)
      usage
      ;;
    stop)
      [[ $# -eq 2 ]] || die "Usage: vps-tunnel stop <port>"
      stop_forward "$2"
      ;;
    status)
      show_status
      ;;
    '')
      usage
      exit 1
      ;;
    *)
      [[ $# -eq 1 ]] || die "Usage: vps-tunnel <port>"
      start_forward "$1"
      ;;
  esac
}

main "$@"
