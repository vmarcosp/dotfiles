# Ghostty — keep appearance in sync with kitty/kitty.conf where possible

font-family = "Space Mono"
font-size = 14

window-padding-x = 16
window-padding-y = 16
macos-titlebar-style = hidden

# Blur requires opacity < 1. Cells must opt in or tmux/nvim paint opaque backgrounds.
background-opacity = 0.85
background-blur = 25
background-opacity-cells = true

config-file = yugen.conf
